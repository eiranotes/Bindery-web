{
  "name": "bindery-information-site",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "content:collect": "node scripts/content/collect-official.mjs",
    "content:candidates:validate": "node scripts/content/validate-candidates.mjs --all",
    "content:candidates:check-sources": "node scripts/content/validate-candidates.mjs --all --check-sources --write-source-audit --write-review-queue",
    "content:international:validate": "node scripts/content/validate-candidates.mjs --directory content/research/2026-08-05-international-stationery",
    "content:international:check-sources": "node scripts/content/validate-candidates.mjs --directory content/research/2026-08-05-international-stationery --check-sources --write-source-audit --write-review-queue",
    "content:international:pipeline": "npm run content:international:check-sources && npm run content:normalize && npm run content:generate && npm run content:report",
    "content:normalize": "node scripts/content/normalize-candidates.mjs",
    "content:check-normalized": "node scripts/content/normalize-candidates.mjs --check",
    "content:validate": "node scripts/content/validate.mjs",
    "content:generate": "node scripts/content/generate.mjs",
    "content:check-generated": "node scripts/content/generate.mjs --check",
    "content:recheck": "node scripts/content/build-recheck-queue.mjs",
    "content:guard": "node scripts/content/guard.mjs",
    "content:report": "node scripts/content/report.mjs",
    "content:pipeline": "npm run content:collect && npm run content:candidates:check-sources && npm run content:normalize && npm run content:validate && npm run content:generate && npm run content:recheck && npm run content:report",
    "reviews:collect": "node scripts/content/reviews.mjs collect",
    "reviews:report": "node scripts/content/reviews.mjs report",
    "reviews:archive": "node scripts/content/reviews.mjs archive",
    "reviews:twscrape:setup": "${TWSCRAPE_SETUP_PYTHON:-python3.11} -m venv --clear content-local/reviews/twscrape/.venv && content-local/reviews/twscrape/.venv/bin/python -m pip install --disable-pip-version-check -r tools/review-collectors/twscrape/requirements.txt",
    "pages:build": "npm run build && node scripts/build-pages-preview.mjs",
    "test": "npm run content:guard && npm run content:candidates:validate && npm run content:check-normalized && npm run content:validate && npm run content:check-generated && npm run typecheck && npm run build && node --test tests/*.test.mjs tests/*.test.ts && vitest run --config vitest.config.ts && npm run test:browser",
    "test:community-db": "bash scripts/test-community-db.sh supabase/tests/community_rls.test.sql",
    "test:browser": "playwright test --config playwright.config.ts",
    "typecheck": "tsc --noEmit --incremental false",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.3",
    "@supabase/supabase-js": "^2.110.8",
    "next": "^16.2.12",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "^4.20260702.1",
    "@playwright/test": "1.62.0",
    "@tailwindcss/postcss": "4.2.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.12",
    "jsdom": "29.1.1",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "vitest": "4.1.10",
    "wrangler": "4.92.0"
  },
  "overrides": {
    "postcss": "8.5.23",
    "sharp": "0.35.3"
  },
  "type": "module"
}
